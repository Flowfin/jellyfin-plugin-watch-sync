<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One target per server line this plugin supports. The two lines do not sit on
         one framework, so a single target cannot serve both: 10.11 builds on net9.0
         and 12.0 on net10.0. build.yaml declares the ABI beside each of them and
         BuildTargetsTests refuses the two lists disagreeing. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.WatchSync</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- The lifetime hook is the one thing neither server line offers through the packages
       above. A subscription to the library's events has to be made by something the server
       starts and unmade when it stops, MediaBrowser.Controller carries no entry point type on
       either line, and the hosting abstractions are referenced by that assembly without being
       declared as a dependency of it, so the interface is not on this project's graph without
       this. The version on each line is the one the rest of that line's graph already resolves
       to, so nothing else in the lock file moves for it, and the runtime assets are excluded
       for the same reason as above: the server carries the assembly.

       This is the whole cost of the means, and it is written here rather than only in the
       change that added it. -->
  <!-- Pinned per line rather than floating. The server carries these assemblies, so the
       runtime assets are excluded and only the reference assemblies are used; shipping a
       second copy inside the plugin is how a plugin ends up loading types the server does
       not recognise. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
