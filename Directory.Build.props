<Project>

    <!--
        build.yaml holds the version, and it is the only file that does. It is the
        manifest a server reads to decide whether an install is an upgrade, and it is
        what the packaging tool reads to name the artifact it produces, so it cannot be
        made to derive from anywhere else. Everything that can derive from it, does.

        The read is one anchored line rather than a parse, for the same reason the guid
        read in the test project is: the key sits at column zero in a hand-maintained
        manifest, and a YAML parser would be a dependency for one field. A version moved
        into a nested mapping would not be found, which the target below turns into a
        refused build rather than a silent zero.
    -->
    <PropertyGroup>
        <!-- The graph is watched, not only recorded. NuGet checks the restored graph
             against the advisory database and NU1901 to NU1904 are raised to errors, so a
             known-vulnerable package fails the restore. Left as warnings they would be
             true and green, printed into a log nobody reads.
    
             This board committed a lockfile and ran no audit, which is the worse half of
             the pair: the graph was held still and nothing looked at it. Eleven boards of
             this fleet were in that state on 2026-08-18, and the twelfth is why it
             matters. jellyfin-plugin-watchlist was told by Scorecard about one high
             advisory; switching this on found a second one rated critical that Scorecard
             had never reported.
    
             Mode all rather than direct: both of those arrived under the Jellyfin
             packages and neither was referenced by a project file, so a direct-only audit
             would have found neither.
    
             Nothing is pinned here. Measured with the audit forced on from the command
             line, this board reports no advisory today; the entry is the detector, not a
             repair.
    
             Note for whoever edits this comment: an XML comment may not contain two
             hyphens in a row. A draft elsewhere in this fleet spelled out a command line
             flag, left the file malformed, and the build failed on a property defined
             twenty lines below. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <PluginManifest>$(MSBuildThisFileDirectory)build.yaml</PluginManifest>
        <_PluginManifestText Condition="Exists('$(PluginManifest)')">$([System.IO.File]::ReadAllText('$(PluginManifest)'))</_PluginManifestText>
        <_PluginManifestVersionLine>$([System.Text.RegularExpressions.Regex]::Match($(_PluginManifestText), `(?m)^version:[ \t]*"[^"]*"`))</_PluginManifestVersionLine>
        <PluginVersion>$([System.Text.RegularExpressions.Regex]::Match($(_PluginManifestVersionLine), `[0-9][0-9.]*`))</PluginVersion>
    </PropertyGroup>

    <!--
        Restore writes a lock file and then refuses to move without it. Two builds of one
        commit otherwise resolve whatever the feed holds on the day they run, so the
        assembly an operator installs is decided by the feed rather than by anything in
        this repository, and a dependency review that passed on Monday says nothing about
        the artifact built on Tuesday.

        Both properties are set here rather than in a workflow, because a restore started
        by an editor, by the packaging step or by somebody's terminal is the same restore
        and gets the same rule. A locked-mode restore against a lock file that does not
        match the project files fails instead of quietly resolving something else, which
        is what makes a package added without a lock file update a red build.

        Adding or changing a package is therefore two edits: the reference, and the lock
        file regenerated by a restore run with NuGet's force-evaluate switch. The switch
        is not spelled out here because an XML comment may not carry two dashes in a row.
        LockFileTests carries it, in a file that can hold it.
    -->
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>

    <PropertyGroup>
        <Version>$(PluginVersion)</Version>
        <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
        <FileVersion>$(PluginVersion)</FileVersion>
    </PropertyGroup>

    <!--
        Without this the three properties above are empty, every assembly reports 0.0.0.0,
        and the build succeeds. That is the failure this refuses: a release nobody can tell
        apart from the one before it, discovered after it shipped rather than while it was
        being built.
    -->
    <Target Name="RefuseAVersionTheManifestDoesNotCarry" BeforeTargets="BeforeBuild">
        <Error Condition="!Exists('$(PluginManifest)')"
               Text="The build manifest was not found at $(PluginManifest). It is where the version is written and there is no second place to read it from." />
        <Error Condition="'$(PluginVersion)' == ''"
               Text="$(PluginManifest) carries no version at column zero in the form version: &quot;1.0.0.0&quot;, so there is nothing for the assembly version to derive from." />
    </Target>

</Project>
