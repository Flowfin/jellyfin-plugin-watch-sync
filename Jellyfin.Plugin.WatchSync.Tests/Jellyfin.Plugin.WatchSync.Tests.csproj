<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The suite runs once per target the plugin builds, because the facts it checks
         differ per target: each one references a different server line and carries a
         different declared ABI. A single-target suite would leave one of them unmeasured
         and green. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.WatchSync.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The packaging step publishes the solution into one output directory and
         copies the files build.yaml names out of it. IsPublishable keeps the test
         assembly and its runner out of that directory in the first place. -->
    <IsPublishable>false</IsPublishable>
    <!-- #70 asks that a process be killed in the middle of a write. A killed process has to
         be a process, and it cannot be the test host, because killing that ends the run. The
         entry point the test SDK generates does nothing, so it is turned off and Program.cs
         stands in its place: the case starts this same assembly as a child, lets it write
         through the plugin's own store, and kills it. `dotnet test` never reaches it, because
         the adapter loads the assembly and starts at the facts. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The coverage collector runs inside the same test host the suite already uses,
         so the measurement is of the run rather than of a second run arranged to be
         measurable. Runtime assets only: it instruments the host and nothing it produces
         is referenced from a test, and a collector on the compile surface would be a
         package the suite could accidentally start writing against. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.WatchSync\Jellyfin.Plugin.WatchSync.csproj" />
  </ItemGroup>

  <!-- The build manifest is one of three places that have to agree on the plugin
       identifier, so a test reads it. Copying the real file rather than a fixture is
       deliberate: a fixture would prove the state of a copy on the day it was written. -->
  <ItemGroup>
    <None Include="..\build.yaml" Link="build.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The plugin excludes the runtime assets of these two, because a server already
       carries them and shipping a second copy inside the plugin is how a plugin ends
       up loading types the server does not recognise. Nothing carries them into a test
       host, so the test project asks for them itself. These are a floor rather than a
       pin: NuGet resolves to the highest version any project asks for, so raising the
       plugin's own reference raises what the tests run against and never the reverse. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc4" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc4" />
  </ItemGroup>

</Project>
